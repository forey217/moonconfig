    ),
  )
  guard response is Object(o) else { fail("response shape") }
  assert_eq(o["ok"], Json::boolean(true))
  assert_eq(o["result"], @json.parse("{\"/\":9,\"~1\":10}"))
}

///|
test "upstream spec_tests.json 15" {
  let response = @json.parse(
    run_json(
      "{\"command\":\"apply\",\"document\":{\"/\":9,\"~1\":10},\"patch\":[{\"op\":\"test\",\"path\":\"/~01\",\"value\":\"10\"}]}",
    ),
  )
  guard response is Object(o) else { fail("response shape") }
  assert_eq(o["ok"], Json::boolean(false))
}

///|
test "upstream spec_tests.json 16" {
  let response = @json.parse(
    run_json(
      "{\"command\":\"apply\",\"document\":{\"foo\":[\"bar\"]},\"patch\":[{\"op\":\"add\",\"path\":\"/foo/-\",\"value\":[\"abc\",\"def\"]}]}",
    ),
  )
  guard response is Object(o) else { fail("response shape") }
  assert_eq(o["ok"], Json::boolean(true))
  assert_eq(o["result"], @json.parse("{\"foo\":[\"bar\",[\"abc\",\"def\"]]}"))
}
